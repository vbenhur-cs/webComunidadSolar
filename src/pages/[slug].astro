---
export const prerender = true;

import AerothermalPage from "../components/pages/home-energy/AerothermalPage.astro";
import AboutPage from "../components/pages/about/AboutPage.astro";
import BatteriesPage from "../components/pages/home-energy/BatteriesPage.astro";
import BlogPage from "../components/pages/blog/BlogPage.astro";
import CommercializerPage from "../components/pages/home-energy/CommercializerPage.astro";
import EventsPage from "../components/pages/events/EventsPage.astro";
import MaintenancePage from "../components/pages/home-energy/MaintenancePage.astro";
import RemotePage from "../components/pages/remote/RemotePage.astro";
import SolarInstallationPage from "../components/pages/home-energy/SolarInstallationPage.astro";
import CommunitiesPage from "../components/pages/communities/CommunitiesPage.astro";
import MemberPage from "../components/pages/member/MemberPage.astro";
import ContactPage from "../components/pages/contact/ContactPage.astro";
import AssetsPage from "../components/pages/assets/AssetsPage.astro";
import OperationalAssetsPage from "../components/pages/assets/OperationalAssetsPage.astro";
import LegalPage from "../components/pages/legal/LegalPage.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getLegacyRedirect } from "../lib/routing/legacy";
import {
  isCorePageKey,
  isLegalPageKey,
  pageRegistry,
  staticSlugPaths,
  type CorePageKey,
  type HeaderPageKey,
  type LegalPageKey,
} from "../lib/site/page-registry";

export function getStaticPaths() {
  return staticSlugPaths.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug;
const legacyDestination = slug ? getLegacyRedirect(`/${slug}`) : undefined;
if (legacyDestination !== undefined) {
  return Astro.redirect(legacyDestination, 308);
}

const match = slug
  ? (
      Object.entries(pageRegistry) as [
        HeaderPageKey,
        (typeof pageRegistry)[HeaderPageKey],
      ][]
    ).find(([, entry]) => entry.path === `/${slug}`)
  : undefined;
if (match === undefined || !isCorePageKey(match[0])) {
  return new Response("Not Found", {
    status: 404,
    headers: { "content-type": "text/plain;charset=UTF-8" },
  });
}

const [page, entry] = match;
const components = {
  nosotros: AboutPage,
  remoto: RemotePage,
  comunidades: CommunitiesPage,
  fotovoltaica: SolarInstallationPage,
  baterias: BatteriesPage,
  aerotermia: AerothermalPage,
  mantenimiento: MaintenancePage,
  comercializadora: CommercializerPage,
  blog: BlogPage,
  eventos: EventsPage,
  comunero: MemberPage,
  contacto: ContactPage,
  activos: AssetsPage,
  activoConectado: OperationalAssetsPage,
} as const;
const legalDocumentKey = isLegalPageKey(page as CorePageKey)
  ? (page as LegalPageKey)
  : undefined;
const Component =
  legalDocumentKey === undefined
    ? components[page as Exclude<CorePageKey, LegalPageKey>]
    : undefined;
---

<SiteLayout
  page={page}
  meta={{
    title: entry.title ?? null,
    description: entry.description ?? null,
    canonical: legalDocumentKey === undefined ? entry.path : null,
    ...(legalDocumentKey !== undefined
      ? { robots: { index: false, follow: page === "privacy" } }
      : {}),
  }}
>
  {
    legalDocumentKey ? (
      <LegalPage documentKey={legalDocumentKey} />
    ) : (
      Component && <Component />
    )
  }
</SiteLayout>
