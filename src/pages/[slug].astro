---
export const prerender = true;

import AerothermalPage from "../components/pages/home-energy/AerothermalPage.astro";
import BatteriesPage from "../components/pages/home-energy/BatteriesPage.astro";
import CommercializerPage from "../components/pages/home-energy/CommercializerPage.astro";
import MaintenancePage from "../components/pages/home-energy/MaintenancePage.astro";
import SolarInstallationPage from "../components/pages/home-energy/SolarInstallationPage.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getLegacyRedirect } from "../lib/routing/legacy";
import {
  isCorePageKey,
  pageRegistry,
  staticSlugPaths,
  type CorePageKey,
  type HeaderPageKey,
} from "../lib/site/page-registry";

export function getStaticPaths() {
  return staticSlugPaths.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug;
const legacyDestination = slug ? getLegacyRedirect(`/${slug}`) : undefined;
if (legacyDestination !== undefined) {
  return Astro.redirect(legacyDestination, 308);
}

const match = slug
  ? (
      Object.entries(pageRegistry) as [
        HeaderPageKey,
        (typeof pageRegistry)[HeaderPageKey],
      ][]
    ).find(([, entry]) => entry.path === `/${slug}`)
  : undefined;
if (match === undefined || !isCorePageKey(match[0])) {
  return new Response(null, { status: 404 });
}

const [page, entry] = match;
const components = {
  fotovoltaica: SolarInstallationPage,
  baterias: BatteriesPage,
  aerotermia: AerothermalPage,
  mantenimiento: MaintenancePage,
  comercializadora: CommercializerPage,
} as const;
const Component = components[page as CorePageKey];
---

<SiteLayout
  page={page}
  meta={{
    title: entry.title ?? null,
    description: entry.description ?? null,
    canonical: entry.path,
  }}
>
  <Component />
</SiteLayout>
