---
import { OperationalPlantForm } from "../../islands/OperationalPlantForm";
import ButtonLink from "../../site/ButtonLink.astro";
import SectionHeading from "../../site/SectionHeading.astro";
import TrustBand from "../../site/TrustBand.astro";
import FaqList from "../home-energy/FaqList.astro";

const plantStudyForm =
  "https://forms.zohopublic.eu/comunidadsolar/form/ProyectosCEListosparagestionarV2/formperma/4gUsAsBhC1C4UXXZlRfTYYFd1yFpzSw_AQp6tTCSZ1Y";
const tomasPhone = "tel:+34603958158";
const tomasMeetingRequest =
  "mailto:tomas.bensadon@comunidadsolar.es?subject=Reuni%C3%B3n%20sobre%20una%20planta%20para%20comunidad%20energ%C3%A9tica&body=Hola%20Tom%C3%A1s%2C%0A%0AMe%20gustar%C3%ADa%20comentar%20contigo%20una%20planta%20que%20podr%C3%ADa%20encajar%20en%20el%20modelo%20de%20Comunidad%20Solar.%0A%0ANombre%3A%0AEmpresa%3A%0AMunicipio%20y%20provincia%20de%20la%20planta%3A%0APotencia%20aproximada%3A%0A%0AGracias.";
const kikeMeetingRequest =
  "mailto:enrique@comunidadsolar.es?subject=Reuni%C3%B3n%20sobre%20una%20planta%20para%20comunidad%20energ%C3%A9tica&body=Hola%20Kike%2C%0A%0AMe%20gustar%C3%ADa%20comentar%20contigo%20una%20planta%20que%20podr%C3%ADa%20encajar%20en%20el%20modelo%20de%20Comunidad%20Solar.%0A%0ANombre%3A%0AEmpresa%3A%0AMunicipio%20y%20provincia%20de%20la%20planta%3A%0APotencia%20aproximada%3A%0A%0AGracias.";

const alternatives = [
  [
    "01",
    "Mercado",
    "Flexibilidad y salida inmediata.",
    "La planta vende su producción al mercado y conserva flexibilidad, pero sus ingresos quedan expuestos al precio mayorista de cada momento.",
  ],
  [
    "02",
    "PPA",
    "Visibilidad a largo plazo.",
    "Un precio pactado aporta previsibilidad, aunque concentra la relación en una contraparte y fija una parte del valor futuro.",
  ],
  [
    "03",
    "Venta del activo",
    "Liquidez hoy.",
    "La venta permite materializar el valor de la planta, pero también transfiere su control y su posible recorrido futuro.",
  ],
  [
    "04",
    "Comunidad energética",
    "El activo se conecta con su demanda.",
    "La producción disponible se asigna a hogares y empresas cercanas. El modelo puede capturar más valor, pero exige plataforma, comercialización y operación continua.",
  ],
] as const;

const platformLayers = [
  [
    "01",
    "Convertimos datos en demanda",
    [
      "Analizamos facturas y curvas reales de consumo.",
      "Cruzamos producción, horarios y necesidades energéticas.",
      "Generamos propuestas adaptadas a cada usuario.",
    ],
  ],
  [
    "02",
    "Convertimos interés en contratos",
    [
      "Activamos canales de captación locales y digitales.",
      "Gestionamos ofertas, contratación y altas.",
      "Organizamos asignaciones y coeficientes de reparto.",
    ],
  ],
  [
    "03",
    "Convertimos contratos en operación",
    [
      "Integramos la energía mediante nuestra comercializadora.",
      "Gestionamos facturación, cobros y liquidaciones.",
      "Atendemos a los usuarios y damos seguimiento al partner.",
    ],
  ],
] as const;

const process = [
  [
    "01",
    "Analizamos el activo",
    "Revisamos la documentación disponible sobre titularidad, ubicación, potencia, producción, conexión, medida, situación administrativa y compromisos comerciales actuales.",
  ],
  [
    "02",
    "Comprobamos la demanda",
    "Estudiamos hogares y empresas que podrían recibir energía dentro del ámbito aplicable.",
  ],
  [
    "03",
    "Diseñamos el modelo",
    "Definimos oferta, capacidad, responsabilidades, economía, energía no asignada y calendario.",
  ],
  [
    "04",
    "Lanzamos la comunidad",
    "Captamos usuarios, analizamos consumos, formalizamos contratos y coordinamos las altas.",
  ],
  [
    "05",
    "La operamos cada día",
    "Gestionamos comercializadora, facturas, cobros, atención, información y evolución de la ocupación.",
  ],
] as const;

const faqs = [
  {
    question: "¿Tengo que vender la planta a Comunidad Solar?",
    answer:
      "No. El modelo habitual parte de que el partner mantiene la propiedad del activo. El acuerdo define la capacidad incorporada, las responsabilidades de cada parte, la duración y las condiciones económicas.",
  },
  {
    question:
      "¿Puede encajar una planta que ahora vende a mercado o tiene un PPA?",
    answer:
      "Sí puede estudiarse, pero primero debemos revisar qué energía está comprometida, durante cuánto tiempo y qué permiten los contratos vigentes. La incorporación puede plantearse sobre toda la capacidad disponible o solo sobre una parte.",
  },
  {
    question: "¿Quién encuentra y contrata a los usuarios?",
    answer:
      "Comunidad Solar diseña la oferta, activa la captación, analiza los consumos y gestiona la contratación digital. La viabilidad y el ritmo de incorporación dependen de la demanda real de cada entorno.",
  },
  {
    question: "¿Quién factura, cobra y atiende a los participantes?",
    answer:
      "Nuestra comercializadora y Helios conectan la energía asignada con la factura, los cobros, la atención y el seguimiento. El acuerdo concreta también cómo y cuándo se liquida al partner.",
  },
  {
    question: "¿Qué ocurre con la energía que todavía no está asignada?",
    answer:
      "La propuesta define una salida comercial para esa energía durante el periodo de captación. No damos por supuesto que toda la capacidad se ocupe desde el primer día.",
  },
  {
    question: "¿Puede necesitar adaptaciones la instalación?",
    answer:
      "Depende del activo. Medida, comunicaciones, protecciones, configuración administrativa o contratos pueden requerir ajustes. Los identificamos antes de cerrar la propuesta y acordamos quién asume cada actuación.",
  },
  {
    question: "¿Cuánto tarda la conversión?",
    answer:
      "No existe un plazo único. Influyen la situación de la planta, los contratos vigentes, la distribuidora, las posibles adaptaciones y la captación de usuarios. Tras el análisis inicial presentamos un calendario realista para ese activo.",
  },
  {
    question: "¿Qué información necesitáis para empezar?",
    answer:
      "Pedimos información suficiente para saber que existe un activo real y evaluable: titularidad o derecho de explotación, ubicación, potencia, documentación técnica, fecha de puesta en marcha, acceso y conexión, permisos y legalización, medida, producción, contratos vigentes y energía disponible. Un propietario o promotor de una planta madura suele disponer de esta documentación. Solicitarla desde el inicio nos permite concentrar el análisis en proyectos serios y no hacer perder tiempo ni esfuerzo a ninguna de las partes.",
  },
];
---

<main class="operational-assets-page">
  <section
    class="operational-value-hero"
    aria-labelledby="operational-value-hero-title"
  >
    <div class="operational-value-scene">
      <div class="operational-value-visual" aria-hidden="true">
        <img
          src="/media/hero-operativas-red-de-valor-clean-1024x792.png"
          alt=""
        />
        <svg
          class="operational-energy-network"
          viewBox="0 0 1024 792"
          preserveAspectRatio="xMidYMid slice"
        >
          <defs>
            <filter
              id="operational-energy-glow"
              x="-40%"
              y="-40%"
              width="180%"
              height="180%"
            >
              <feGaussianBlur stdDeviation="4" result="blur"></feGaussianBlur>
              <feMerge
                ><feMergeNode in="blur"></feMergeNode><feMergeNode
                  in="SourceGraphic"></feMergeNode></feMerge
              >
            </filter>
            <linearGradient
              id="operational-energy-gold"
              x1="0"
              y1="1"
              x2="1"
              y2="0"
            >
              <stop offset="0" stop-color="#fff9df"></stop><stop
                offset="0.55"
                stop-color="#ffc62a"></stop><stop
                offset="1"
                stop-color="#fff3a3"></stop>
            </linearGradient>
            <linearGradient
              id="operational-energy-green"
              x1="0"
              y1="1"
              x2="1"
              y2="0"
            >
              <stop offset="0" stop-color="#fff9df"></stop><stop
                offset="0.55"
                stop-color="#b9dc5a"></stop><stop
                offset="1"
                stop-color="#e8f4a9"></stop>
            </linearGradient>
          </defs>
          <g
            class="operational-network-lines operational-network-input"
            filter="url(#operational-energy-glow)"
          >
            <path d="M410 790 C446 637 530 487 620 338"></path><path
              d="M482 790 C502 625 556 474 620 338"></path><path
              d="M554 790 C558 612 583 461 620 338"></path><path
              d="M626 790 C615 604 610 450 620 338"></path>
          </g>
          <g
            class="operational-network-lines operational-network-output"
            filter="url(#operational-energy-glow)"
          >
            <path d="M620 338 C568 332 521 338 469 363"></path><path
              d="M620 338 C628 298 620 275 589 258"></path><path
              d="M620 338 C699 278 760 270 817 282"></path><path
              d="M620 338 C728 330 812 347 874 380"></path><path
              d="M620 338 C705 392 766 424 818 442"></path><path
              d="M620 338 C775 366 874 425 950 477"></path>
          </g>
          <g
            class="operational-network-destinations"
            filter="url(#operational-energy-glow)"
          >
            <circle cx="469" cy="363" r="7"></circle><circle
              cx="589"
              cy="258"
              r="7"></circle><circle cx="817" cy="282" r="7"></circle><circle
              cx="874"
              cy="380"
              r="7"></circle><circle cx="818" cy="442" r="7"></circle><circle
              cx="950"
              cy="477"
              r="7"></circle>
          </g>
          <g class="operational-network-helios">
            <circle class="operational-network-halo" cx="620" cy="338" r="54"
            ></circle><circle
              class="operational-network-ring"
              cx="620"
              cy="338"
              r="46"></circle><circle
              class="operational-network-core"
              cx="620"
              cy="338"
              r="40"></circle>
            <text x="620" y="346" text-anchor="middle">HELIOS</text>
          </g>
        </svg>
      </div>
      <div class="shell operational-value-stage">
        <div class="operational-value-copy">
          <p class="eyebrow">
            Activo Conectado · Para propietarios, promotores y fondos
          </p>
          <h1 id="operational-value-hero-title">
            Tu planta ya produce. Convirtámosla en una comunidad energética.
          </h1>
          <p>
            Tú aportas el activo. Nosotros ponemos Helios, la comercializadora,
            la captación y la operación para conectarlo con la demanda local.
          </p>
          <div class="hero-actions">
            <OperationalPlantForm client:visible />
            <ButtonLink href="#modelo" kind="secondary"
              >Ver cómo funciona</ButtonLink
            >
          </div>
        </div>
      </div>
    </div>
    <div class="operational-value-pillars">
      <ul class="shell">
        <li>
          <svg viewBox="0 0 48 48" aria-hidden="true"
            ><circle cx="24" cy="24" r="8"></circle><path
              d="M24 3v7M24 38v7M3 24h7M38 24h7M9.2 9.2l5 5M33.8 33.8l5 5M38.8 9.2l-5 5M14.2 33.8l-5 5"
            ></path></svg
          ><strong>Activo que ya produce</strong>
        </li>
        <li>
          <svg viewBox="0 0 48 48" aria-hidden="true"
            ><rect x="5" y="7" width="38" height="28" rx="3"></rect><path
              d="M16 43h16M24 35v8M18 27c1-7 7-11 14-10-1 7-6 11-14 10Zm0 0 9-7"
            ></path></svg
          ><strong>Plataforma y comercializadora</strong>
        </li>
        <li>
          <svg viewBox="0 0 48 48" aria-hidden="true"
            ><path
              d="m4 22 20-17 20 17M9 19v24h30V19M20 43V30h8v13M34 12V6h6v11"
            ></path></svg
          ><strong>Demanda de proximidad</strong>
        </li>
      </ul>
    </div>
  </section>

  <TrustBand compact />

  <section class="section operational-alternatives" id="alternativas">
    <div class="shell">
      <SectionHeading
        eyebrow="Una nueva vía de explotación"
        title="El reto ya no es generar energía. Es capturar todo el valor de la que ya generas."
        copy="Mercado, PPA y venta del activo son soluciones válidas para objetivos distintos. Una comunidad energética añade una cuarta vía: conectar la planta con consumidores de proximidad y construir una relación estable alrededor de su producción."
      />
      <div class="operational-alternative-grid">
        {
          alternatives.map(([number, name, title, copy], index) => (
            <article
              class={
                index === 3
                  ? "operational-alternative-card is-featured"
                  : "operational-alternative-card"
              }
            >
              <>
                <span>{number}</span>
                <small>{name}</small>
                <h3>{title}</h3>
                <p>{copy}</p>
              </>
              {index === 3 && (
                <strong>La vía que nosotros hacemos operativa</strong>
              )}
            </article>
          ))
        }
      </div>
      <aside class="operational-alternatives-note">
        <strong>No sustituye automáticamente cualquier modelo.</strong><p>
          La comunidad energética puede aplicarse a toda la producción
          disponible o convivir con otras vías cuando los contratos, la
          regulación, el activo y la demanda local lo permiten.
        </p>
      </aside>
    </div>
  </section>

  <section
    class="operational-partnership"
    id="modelo"
    aria-labelledby="operational-partnership-title"
  >
    <div class="shell operational-partnership-panel">
      <div class="operational-partnership-heading">
        <p class="eyebrow">El modelo, en una mirada</p><h2
          id="operational-partnership-title"
        >
          Cada parte aporta lo que sabe hacer. Compartimos lo que se cobra.
        </h2><p>
          Un partnership sencillo: el propietario mantiene su activo y nosotros
          construimos y operamos la comunidad alrededor de su producción.
        </p>
      </div>
      <div class="operational-partnership-visual">
        <div class="operational-partnership-contributions">
          <article>
            <span>EL PROPIETARIO</span><h3>
              La planta operativa y su mantenimiento.
            </h3><p>
              Conserva la propiedad, aporta la producción disponible y se ocupa
              de que el activo siga operativo.
            </p>
          </article>
          <article>
            <span>COMUNIDAD SOLAR</span><h3>
              La plataforma, la comercialización y la venta.
            </h3><p>
              Aportamos Helios, captamos usuarios, formalizamos contratos,
              facturamos y gestionamos los cobros.
            </p>
          </article>
        </div>
        <div class="operational-partnership-revenue">
          <span>REPARTO SOBRE INGRESOS EFECTIVAMENTE COBRADOS</span><div
            class="operational-partnership-bar"
            role="img"
            aria-label="80% para el propietario y 20% para Comunidad Solar"
          >
            <div><strong>80%</strong><span>Para el propietario</span></div><div>
              <strong>20%</strong><span>Para Comunidad Solar</span>
            </div>
          </div><p>
            El reparto se aplica únicamente a los ingresos que se han cobrado:
            ambas partes avanzamos cuando la comunidad funciona.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="operational-model">
    <div class="shell">
      <div class="operational-model-heading">
        <div>
          <p class="eyebrow">Más que vender energía</p><h2>
            No necesitas montar una comercializadora. Ya lo somos nosotros.
          </h2>
        </div><p>
          No nos limitamos a buscar una salida para los kWh. Construimos y
          operamos la comunidad que conecta producción, contratos, reparto,
          factura y atención.
        </p>
      </div>
      <ol
        class="operational-model-flow"
        aria-label="Del activo a la comunidad energética"
      >
        {
          [
            ["01", "Tu activo", "Producción disponible"],
            ["02", "Nuestra plataforma", "Helios + comercializadora"],
            ["03", "La comunidad", "Hogares y empresas"],
            ["04", "Valor compartido", "Liquidación al partner"],
          ].map(([number, title, copy]) => (
            <li>
              <>
                <span>{number}</span>
                <h3>{title}</h3>
                <p>{copy}</p>
              </>
            </li>
          ))
        }
      </ol>
      <div class="operational-responsibility-grid">
        <article>
          <span>EL PARTNER</span><h3>
            Conserva el activo y aporta la producción.
          </h3><ul>
            <li>Mantiene habitualmente la propiedad de la planta.</li><li>
              Facilita sus datos técnicos, energéticos y contractuales.
            </li><li>
              Se ocupa de la operación y el mantenimiento físico del activo.
            </li>
          </ul>
        </article>
        <article>
          <span>COMUNIDAD SOLAR</span><h3>
            Aporta la plataforma y opera la comunidad.
          </h3><ul>
            <li>Analiza, estructura y lanza el modelo comercial.</li><li>
              Capta, contrata y atiende a hogares y empresas.
            </li><li>
              Gestiona reparto, comercializadora, facturación, cobros y
              seguimiento.
            </li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="section operational-platform">
    <div class="shell">
      <div class="operational-platform-heading">
        <div>
          <p class="eyebrow">Helios</p><h2>
            La plataforma que conecta la planta, los usuarios y la factura.
          </h2>
        </div><p>
          La tecnología no es una capa decorativa. Es lo que permite analizar
          demanda, automatizar propuestas, contratar usuarios y mantener
          operativa una comunidad que cambia cada mes.
        </p>
      </div>
      <div class="operational-platform-grid">
        {
          platformLayers.map(([number, title, items]) => (
            <article>
              <>
                <span>{number}</span>
                <h3>{title}</h3>
                <ul>
                  {items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </>
            </article>
          ))
        }
      </div>
      <div class="operational-platform-rail">
        {
          [
            "Análisis automatizado de facturas",
            "Curvas de consumo",
            "Ofertas personalizadas",
            "Contratación digital",
            "Gestión regulatoria",
            "Operación continua",
          ].map((capability) => <span>{capability}</span>)
        }
      </div>
    </div>
  </section>

  <section class="operational-process">
    <div class="shell">
      <SectionHeading
        eyebrow="De planta operativa a comunidad energética"
        title="Del primer análisis a una comunidad funcionando."
        copy="Trabajamos contigo desde la primera revisión de la planta hasta que la comunidad está funcionando. Nuestro equipo estudia el activo, define el modelo, coordina la captación y acompaña la puesta en marcha. Helios agiliza cada etapa; el criterio y el seguimiento los ponen personas que conocen el proyecto."
      />
      <ol class="operational-process-grid">
        {
          process.map(([number, title, copy]) => (
            <li>
              <>
                <span>{number}</span>
                <h3>{title}</h3>
                <p>{copy}</p>
              </>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section operational-economics" id="colaboracion">
    <div class="shell operational-economics-grid">
      <div>
        <p class="eyebrow">Modelo de colaboración</p><h2>
          El propietario conserva el activo. Compartimos el valor que hacemos
          posible.
        </h2><p>
          El partner mantiene la propiedad y recibe el 80% de los ingresos
          efectivamente cobrados. Comunidad Solar recibe el 20% por aportar la
          plataforma, captar usuarios y operar el modelo a largo plazo.
        </p>
      </div>
      <div class="operational-economics-cards">
        <article>
          <span>PROPIEDAD</span><strong>La planta sigue siendo tuya.</strong><p>
            El acuerdo no parte de vender el activo, sino de definir cómo
            ponemos a trabajar su capacidad disponible.
          </p>
        </article>
        <article>
          <span>ALINEACIÓN</span><strong
            >Crecemos cuando la comunidad crece.</strong
          ><p>
            Solo participamos sobre ingresos efectivamente cobrados: el reparto
            vincula nuestra retribución al funcionamiento real.
          </p>
        </article>
        <article>
          <span>FLEXIBILIDAD</span><strong>Conversión total o parcial.</strong
          ><p>
            La propuesta puede trabajar con toda la capacidad compatible o con
            una parte, respetando los compromisos que ya existan.
          </p>
        </article>
      </div>
    </div>
    <div class="shell operational-economics-cta">
      <div>
        <span>PRIMER PASO</span><strong
          >Comprobemos si activo, regulación y demanda encajan.</strong
        >
      </div><ButtonLink
        href={plantStudyForm}
        analyticsEvent="operational_plant_study_open"
        ariaControls="formulario-planta">Analizar mi planta</ButtonLink
      >
    </div>
  </section>

  <section class="operational-fit">
    <div class="shell operational-fit-grid">
      <div>
        <p class="eyebrow">Qué estudiamos</p><h2>
          No todas las plantas encajan. Por eso empezamos por comprobarlo.
        </h2><p>
          Nos dirigimos a propietarios, promotores, fondos y operadores con
          activos construidos o muy próximos a entrar en operación y con
          información suficiente para poder evaluarlos con rigor. Buscamos
          proyectos maduros, no ideas preliminares. También podemos estudiar
          carteras y otros activos renovables caso a caso.
        </p><a class="text-link" href="/rentabiliza-tu-activo#cubierta"
          >¿Tienes una cubierta sin instalación? Ver el otro modelo <span
            aria-hidden="true">↗</span
          ></a
        >
      </div>
      <div class="operational-fit-lists">
        <article>
          <span>EL ACTIVO SUELE ENCAJAR SI…</span><ul>
            <li>
              Está operativo, construido o próximo a su puesta en marcha.
            </li><li>Su situación técnica y administrativa está clara.</li><li>
              Existe energía disponible o flexibilidad contractual.
            </li><li>
              Hay demanda potencial suficiente en su entorno aplicable.
            </li><li>
              La economía soporta las adaptaciones que puedan ser necesarias.
            </li>
          </ul>
        </article>
        <article>
          <span>PARA PODER ANALIZARLO NECESITAMOS…</span><ul>
            <li>
              Identificación de la planta, titular y derecho de explotación.
            </li><li>
              Ubicación, tecnología, potencia y documentación técnica.
            </li><li>
              Acceso y conexión, permisos, legalización y sistema de medida.
            </li><li>
              Producción histórica o estimaciones representativas.
            </li><li>
              Contratos vigentes: mercado, PPA, autoconsumo u otros.
            </li><li>
              Energía disponible y situación de operación y mantenimiento.
            </li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="section operational-faq">
    <div class="shell operational-faq-grid">
      <SectionHeading
        eyebrow="Preguntas decisivas"
        title="Lo que conviene aclarar antes de avanzar."
        copy="La página explica el modelo comercial. El análisis y el acuerdo concretan después la realidad de cada activo."
      /><FaqList items={faqs} />
    </div>
  </section>

  <section class="operational-closing" id="solicitar-analisis">
    <div class="shell operational-closing-grid">
      <div>
        <p class="eyebrow">Proyectos maduros</p><h2>
          Si tienes una planta real y documentada, estudiemos su encaje.
        </h2><p>
          El formulario solicita información técnica, administrativa, energética
          y contractual suficiente para hacer una primera lectura útil. Así
          podemos darte una respuesta seria y evitar dedicar tiempo y esfuerzo a
          oportunidades todavía inmaduras.
        </p>
      </div>
      <div class="operational-closing-options">
        <div class="operational-closing-action">
          <span>EVALUACIÓN DE ENCAJE · ACTIVOS DOCUMENTADOS</span><strong
            >Tu activo puede ser el origen de una nueva comunidad.</strong
          ><ButtonLink
            href={plantStudyForm}
            analyticsEvent="operational_plant_study_open"
            ariaControls="formulario-planta"
            >Analizar el encaje de mi planta</ButtonLink
          ><small
            >La información completa nos permite evaluar el proyecto; la
            solicitud no supone la aceptación del activo ni una oferta
            económica. Trataremos los datos conforme a nuestra<Fragment
              set:html="<!-- -->"
            />{" "}
            <a href="/politica-privacidad">política de privacidad</a>.</small
          >
        </div>
        <div class="operational-people">
          <div class="operational-people-intro">
            <span>¿PREFIERES HABLARLO ANTES?</span><strong
              >Hay personas detrás de cada proyecto.</strong
            ><p>
              Tomás y Kike trabajan con propietarios y partners para entender
              cada planta y acompañar su conversión en comunidad energética.
            </p>
          </div>
          <div class="operational-people-grid">
            <article class="operational-person-contact">
              <img
                src="/media/tomas-bensadon.png"
                alt="Tomás Bensadón, Gestor de Comunidades Energéticas de Comunidad Solar"
              /><span>EQUIPO DE COMUNIDADES ENERGÉTICAS</span><h3>
                Tomás Bensadón
              </h3><p>Gestor de Comunidades Energéticas</p><div
                class="operational-person-contact-actions"
              >
                <ButtonLink
                  href={tomasMeetingRequest}
                  kind="secondary"
                  analyticsEvent="operational_tomas_meeting_request"
                  >Solicitar una reunión</ButtonLink
                ><a
                  href={tomasPhone}
                  data-analytics-event="operational_tomas_phone_click"
                  >+34 603 958 158</a
                >
              </div><a
                class="operational-person-email"
                href="mailto:tomas.bensadon@comunidadsolar.es"
                data-analytics-event="operational_tomas_email_click"
                >tomas.bensadon@comunidadsolar.es</a
              >
            </article>
            <article class="operational-person-contact">
              <img
                src="/media/kike-saenz.png"
                alt="Kike Sáenz, Gestor de Comunidades Energéticas de Comunidad Solar"
              /><span>EQUIPO DE COMUNIDADES ENERGÉTICAS</span><h3>
                Kike Sáenz
              </h3><p>Gestor de Comunidades Energéticas</p><div
                class="operational-person-contact-actions"
              >
                <ButtonLink
                  href={kikeMeetingRequest}
                  kind="secondary"
                  analyticsEvent="operational_kike_meeting_request"
                  >Solicitar una reunión</ButtonLink
                >
              </div><a
                class="operational-person-email"
                href="mailto:enrique@comunidadsolar.es"
                data-analytics-event="operational_kike_email_click"
                >enrique@comunidadsolar.es</a
              >
            </article>
          </div>
        </div>
      </div>
    </div>
    <div
      id="formulario-planta"
      class="shell operational-form-embed-wrap"
      hidden
    >
    </div>
  </section>
</main>
