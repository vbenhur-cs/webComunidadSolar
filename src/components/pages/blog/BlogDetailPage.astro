---
import type { BlogPost } from "../../../content/blog-runtime";
import { blogPosts } from "../../../content/blog-runtime";
import Pill from "../../site/Pill.astro";
import SectionHeading from "../../site/SectionHeading.astro";
import BlogCard from "./BlogCard.astro";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const related = blogPosts
  .filter(
    (candidate) =>
      candidate.slug !== post.slug && candidate.category === post.category,
  )
  .slice(0, 3);
---

<main class="blog-detail">
  <div class="shell blog-breadcrumb">
    <a href="/blog">Blog</a><span>/</span><span>{post.category}</span>
  </div>
  <article>
    <header class="blog-detail-header">
      <div class="shell blog-detail-heading">
        <div class="blog-detail-meta">
          <Pill tone={post.archive ? "light" : "yellow"}>{post.format}</Pill>
          <span>{post.category}</span>
          <time datetime={post.date}>{post.displayDate}</time>
          {post.location && <span>{post.location}</span>}
        </div>
        <h1>{post.title}</h1>
        <p>{post.excerpt}</p>
      </div>
    </header>
    <div
      class={`shell blog-detail-media ${post.format === "Archivo de evento" ? "blog-detail-media-event" : ""}`}
    >
      <img src={post.image} alt={post.imageAlt} />
      <div class="blog-detail-media-caption">
        <span>{post.imageAlt}</span>
        <a href={post.sourceUrl}
          >Consultar la fuente original <span aria-hidden="true">↗</span></a
        >
      </div>
    </div>
    <div class="shell blog-detail-layout">
      <div class="blog-article-body">
        {post.body.map((paragraph) => <p>{paragraph}</p>)}
        {
          post.archive && (
            <aside class="archive-note">
              <span>Archivo recuperado</span>
              <p>
                Esta historia conserva su fecha original y forma parte de la
                memoria de Comunidad Solar. La hemos reconstruido a partir de
                materiales públicos del momento.
              </p>
            </aside>
          )
        }
      </div>
      <aside class="blog-detail-aside">
        {
          post.highlights && (
            <div class="blog-highlight-card">
              <span>Lo esencial</span>
              <ul>
                {post.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            </div>
          )
        }
        <div class="blog-source-card">
          <span>Fuente y memoria</span>
          <strong>{post.sourceLabel}</strong>
          <a href={post.sourceUrl}
            >Abrir fuente original <span aria-hidden="true">↗</span></a
          >
          {
            post.media && (
              <a href={post.media.url}>
                {post.media.label} <span aria-hidden="true">↗</span>
              </a>
            )
          }
        </div>
      </aside>
    </div>
  </article>
  {
    related.length > 0 && (
      <section class="section blog-related">
        <div class="shell">
          <div class="blog-related-heading">
            <SectionHeading
              eyebrow={`Más de ${post.category.toLowerCase()}`}
              title="La historia continúa."
            />
            <a class="text-link" href="/blog">
              Ver todo el archivo <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class="blog-grid blog-grid-related">
            {related.map((candidate) => (
              <BlogCard post={candidate} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</main>
