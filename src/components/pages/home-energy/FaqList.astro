---
interface Faq {
  question: string;
  answer: string;
}

interface Props {
  items: Faq[];
}

const { items } = Astro.props;
---

<div class="faq-list">
  {
    items.map((item) => (
      <details>
        <summary>
          <span>{item.question}</span>
          <i aria-hidden="true">+</i>
        </summary>
        <p>{item.answer}</p>
      </details>
    ))
  }
</div>
