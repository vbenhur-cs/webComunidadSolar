{
  "$id": "block-page",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "changeId",
    "mode",
    "route",
    "metadata",
    "privacy",
    "contentSha256",
    "blocks"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "changeId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{1,62}[a-z0-9])$"
    },
    "mode": { "const": "blocks" },
    "route": {
      "type": "string",
      "pattern": "^/$|^/(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)(?:/[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*$"
    },
    "metadata": { "$ref": "#/$defs/metadata" },
    "privacy": { "$ref": "#/$defs/privacy" },
    "contentSha256": { "$ref": "#/$defs/hash" },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/hero" },
          { "$ref": "#/$defs/feature" },
          { "$ref": "#/$defs/cta" },
          { "$ref": "#/$defs/steps" },
          { "$ref": "#/$defs/faq" },
          { "$ref": "#/$defs/trust" }
        ]
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "text": { "type": "string", "minLength": 1 },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "index"],
      "properties": {
        "title": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "index": { "type": "boolean" }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["private", "area"],
      "properties": {
        "private": { "type": "boolean" },
        "area": { "enum": ["socios", "equipo", "manganafer", null] }
      },
      "oneOf": [
        {
          "properties": {
            "private": { "const": false },
            "area": { "const": null }
          }
        },
        {
          "properties": {
            "private": { "const": true },
            "area": { "enum": ["socios", "equipo", "manganafer"] }
          }
        }
      ]
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "href"],
      "properties": {
        "label": { "$ref": "#/$defs/text" },
        "href": {
          "type": "string",
          "pattern": "^(?:/(?![/\\\\])|#|https://comunidadsolar\\.es(?:[/?#]|$)|mailto:|tel:)"
        }
      }
    },
    "featureItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "copy"],
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "copy": { "$ref": "#/$defs/text" }
      }
    },
    "stepItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "copy"],
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "copy": { "$ref": "#/$defs/text" }
      }
    },
    "faqItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "answer"],
      "properties": {
        "question": { "$ref": "#/$defs/text" },
        "answer": { "$ref": "#/$defs/text" }
      }
    },
    "trustItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "detail"],
      "properties": {
        "label": { "$ref": "#/$defs/text" },
        "detail": { "$ref": "#/$defs/text" }
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "eyebrow", "title", "lead"],
      "properties": {
        "type": { "const": "hero" },
        "eyebrow": { "$ref": "#/$defs/text" },
        "title": { "$ref": "#/$defs/text" },
        "lead": { "$ref": "#/$defs/text" },
        "primary": { "$ref": "#/$defs/link" },
        "secondary": { "$ref": "#/$defs/link" }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "items"],
      "properties": {
        "type": { "const": "feature" },
        "title": { "$ref": "#/$defs/text" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/featureItem" }
        }
      }
    },
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "copy", "action"],
      "properties": {
        "type": { "const": "cta" },
        "title": { "$ref": "#/$defs/text" },
        "copy": { "$ref": "#/$defs/text" },
        "action": { "$ref": "#/$defs/link" }
      }
    },
    "steps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "steps"],
      "properties": {
        "type": { "const": "steps" },
        "title": { "$ref": "#/$defs/text" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stepItem" }
        }
      }
    },
    "faq": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "items"],
      "properties": {
        "type": { "const": "faq" },
        "title": { "$ref": "#/$defs/text" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/faqItem" }
        }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "items"],
      "properties": {
        "type": { "const": "trust" },
        "title": { "$ref": "#/$defs/text" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/trustItem" }
        }
      }
    }
  }
}
