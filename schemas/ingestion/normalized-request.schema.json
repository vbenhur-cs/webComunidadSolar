{
  "$id": "normalized-request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "changeId",
    "inputKind",
    "intent",
    "audience",
    "targetPath",
    "mode",
    "content",
    "claims",
    "references",
    "assets",
    "seo",
    "privacy",
    "allowedExternalLinks",
    "acceptanceCriteria",
    "inputSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "changeId": { "$ref": "#/$defs/changeId" },
    "inputKind": { "enum": ["request", "page"] },
    "intent": { "type": "string" },
    "audience": { "type": ["string", "null"] },
    "targetPath": { "$ref": "#/$defs/targetPath" },
    "mode": { "$ref": "#/$defs/compositionMode" },
    "content": { "type": "string" },
    "claims": { "$ref": "#/$defs/stringList" },
    "references": { "$ref": "#/$defs/stringList" },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    },
    "seo": { "$ref": "#/$defs/seo" },
    "privacy": { "$ref": "#/$defs/privacy" },
    "allowedExternalLinks": { "$ref": "#/$defs/stringList" },
    "acceptanceCriteria": { "$ref": "#/$defs/acceptanceCriteria" },
    "inputSha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "changeId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{1,62}[a-z0-9])$"
    },
    "targetPath": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^/$|^/(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)(?:/[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*$"
        },
        { "not": { "pattern": "(?:^|/)api(?:/|$)" } }
      ]
    },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "compositionMode": {
      "enum": ["auto", "blocks", "freeform", "hybrid"]
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "stringList": { "type": "array", "items": { "type": "string" } },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "mediaType"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "$ref": "#/$defs/hash" },
        "mediaType": { "type": "string" }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "index"],
      "properties": {
        "title": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "index": { "type": "boolean" }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["private", "area"],
      "properties": {
        "private": { "type": "boolean" },
        "area": { "enum": ["socios", "equipo", "manganafer", null] }
      },
      "oneOf": [
        {
          "properties": {
            "private": { "const": true },
            "area": { "enum": ["socios", "equipo", "manganafer"] }
          }
        },
        {
          "properties": {
            "private": { "const": false },
            "area": { "const": null }
          }
        }
      ]
    }
  }
}
