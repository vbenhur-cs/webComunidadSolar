{
  "$id": "candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "changeId",
    "attemptId",
    "requestSha256",
    "planSha256",
    "baselineCommit",
    "candidateCommit",
    "artifactSha256",
    "buildProfile",
    "routes",
    "files",
    "validations",
    "artifacts",
    "preview",
    "knownDifferences"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "changeId": { "$ref": "#/$defs/changeId" },
    "attemptId": { "type": "string" },
    "requestSha256": { "$ref": "#/$defs/hash" },
    "planSha256": { "$ref": "#/$defs/hash" },
    "baselineCommit": { "type": "string" },
    "candidateCommit": { "type": "string" },
    "artifactSha256": { "$ref": "#/$defs/hash" },
    "buildProfile": { "$ref": "#/$defs/publication" },
    "routes": { "$ref": "#/$defs/stringList" },
    "files": { "$ref": "#/$defs/stringList" },
    "validations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/candidateValidation" }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "preview": { "$ref": "#/$defs/preview" },
    "knownDifferences": {
      "type": "array",
      "items": { "$ref": "#/$defs/knownDifference" }
    }
  },
  "$defs": {
    "changeId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{1,62}[a-z0-9])$"
    },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stringList": { "type": "array", "items": { "type": "string" } },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "configSha256", "environment", "siteIndexable"],
      "properties": {
        "adapter": { "enum": ["local", "cloudflare"] },
        "configSha256": { "$ref": "#/$defs/hash" },
        "environment": { "type": ["string", "null"] },
        "siteIndexable": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "required": ["adapter"],
            "properties": { "adapter": { "const": "local" } }
          },
          "then": {
            "properties": {
              "environment": { "const": null },
              "siteIndexable": { "const": false }
            }
          }
        },
        {
          "if": {
            "required": ["adapter"],
            "properties": { "adapter": { "const": "cloudflare" } }
          },
          "then": {
            "properties": {
              "environment": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "candidateValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence"],
      "properties": {
        "id": { "type": "string" },
        "status": { "const": "passed" },
        "evidence": { "type": "string" },
        "evidenceSha256": { "$ref": "#/$defs/hash" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "$ref": "#/$defs/hash" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "url"],
      "properties": {
        "command": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "knownDifference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "approvalRequired"],
      "properties": {
        "description": { "type": "string" },
        "approvalRequired": { "const": true }
      }
    }
  }
}
