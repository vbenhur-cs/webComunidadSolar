{
  "$id": "candidate-dossier-preimage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "candidateSchemaVersion",
    "changeId",
    "attemptId",
    "requestSha256",
    "planSha256",
    "baselineCommit",
    "candidateCommit",
    "artifactSha256",
    "buildProfile",
    "routes",
    "files",
    "validations",
    "artifacts",
    "preview",
    "knownDifferences"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "sealed-candidate-preimage" },
    "candidateSchemaVersion": { "const": 1 },
    "changeId": { "$ref": "#/$defs/changeId" },
    "attemptId": { "type": "string", "pattern": "^attempt-[0-9]{6}$" },
    "requestSha256": { "$ref": "#/$defs/hash" },
    "planSha256": { "$ref": "#/$defs/hash" },
    "baselineCommit": { "$ref": "#/$defs/commit" },
    "candidateCommit": { "$ref": "#/$defs/commit" },
    "artifactSha256": { "$ref": "#/$defs/hash" },
    "buildProfile": { "$ref": "#/$defs/buildProfile" },
    "routes": {
      "type": "array",
      "items": { "$ref": "#/$defs/hashedValue" }
    },
    "files": {
      "type": "array",
      "items": { "$ref": "#/$defs/hashedValue" }
    },
    "validations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/validation" }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "preview": { "$ref": "#/$defs/preview" },
    "knownDifferences": {
      "type": "array",
      "items": { "$ref": "#/$defs/knownDifference" }
    }
  },
  "$defs": {
    "changeId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{1,62}[a-z0-9])$"
    },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "index": { "type": "integer", "minimum": 0 },
    "buildProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "configSha256",
        "environmentSha256",
        "siteIndexable"
      ],
      "properties": {
        "adapter": { "enum": ["local", "cloudflare"] },
        "configSha256": { "$ref": "#/$defs/hash" },
        "environmentSha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "siteIndexable": { "type": "boolean" }
      }
    },
    "hashedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "valueSha256"],
      "properties": {
        "index": { "$ref": "#/$defs/index" },
        "valueSha256": { "$ref": "#/$defs/hash" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "id",
        "status",
        "evidencePathSha256",
        "evidenceSha256"
      ],
      "properties": {
        "index": { "$ref": "#/$defs/index" },
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "status": { "const": "passed" },
        "evidencePathSha256": { "$ref": "#/$defs/hash" },
        "evidenceSha256": { "$ref": "#/$defs/hash" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "sourcePathSha256",
        "dossierPathSha256",
        "sha256",
        "bytes"
      ],
      "properties": {
        "index": { "$ref": "#/$defs/index" },
        "sourcePathSha256": { "$ref": "#/$defs/hash" },
        "dossierPathSha256": { "$ref": "#/$defs/hash" },
        "sha256": { "$ref": "#/$defs/hash" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commandSha256", "urlSha256"],
      "properties": {
        "commandSha256": { "$ref": "#/$defs/hash" },
        "urlSha256": { "$ref": "#/$defs/hash" }
      }
    },
    "knownDifference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "descriptionSha256", "approvalRequired"],
      "properties": {
        "index": { "$ref": "#/$defs/index" },
        "descriptionSha256": { "$ref": "#/$defs/hash" },
        "approvalRequired": { "const": true }
      }
    }
  }
}
